<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- full screen, no title bar, the game's own dark background while it loads -->
    <style name="Theme.HeelStomp" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <!-- the game is already dark: keep the system's dark mode off its pixels -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
